# Rust
/target
**/target

# Node
node_modules/
dist/
build/
*.node

# Private working notes and local, machine-specific config.
# Nothing at the repository root that begins with a dot is carried, so no ignore rule has to
# name a private directory in order to exclude it — and a new one is covered the day it appears.
/.*
!/.gitignore
!/.cargo/

# OS / editor
.DS_Store
Thumbs.db
*.log
